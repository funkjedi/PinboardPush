{
  "name": "Pinboard Push",
  "version": "0.2.0",
  "description": "An extension that pushes new bookmarks and bookmark changes to Pinboard.",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "host_permissions": [
    "https://api.pinboard.in/v1/*"
  ],
  "icons": {
    "16": "img/16x16.png",
    "48": "img/48x48.png",
    "128": "img/128x128.png"
  },
  "manifest_version": 3
}
